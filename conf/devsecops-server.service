[Unit]
Description=DevSecOps Management Server
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/devsecops
ExecStart=/opt/devsecops/devsecops-server --config /opt/devsecops/configs/config.yaml
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
